`timescale 1ns/1ps

module pipeline_tb();
    reg clk;
    reg rst;
    reg [8:0] sw;
    wire [6:0] hex0, hex1, hex2, hex3, hex4, hex5, hex6, hex7;

    integer rf_file;
    integer dmem_file;
    integer i;

    RISC_V dut (
        .CLOCK_50(clk),
        .KEY (!rst),
        .SW (sw),
        .HEX0(hex0), 
        .HEX1(hex1), 
        .HEX2(hex2), 
        .HEX3(hex3), 
        .HEX4(hex4), 
        .HEX5(hex5), 
        .HEX6(hex6), 
        .HEX7(hex7)
    );

    always #10 clk = ~clk;

    initial begin
        clk = 0;
        rst = 1;
        sw = 9'b0;
        
        #40;
        rst = 0;

        #10000;
        
        $display("\n================ DANG XUAT DU LIEU RA FILE ================");
        
        rf_file = $fopen("register_dump.txt", "w");
        if (rf_file) begin
            $fdisplay(rf_file, "TIME: %t", $time);
            $fdisplay(rf_file, "REG  | HEX VALUE  | DECIMAL");
            $fdisplay(rf_file, "----------------------------");
            for (i = 0; i < 32; i = i + 1) begin
                $fdisplay(rf_file, "x%02d  | %h | %d", i, dut.reg_file.rf[i], dut.reg_file.rf[i]);
            end
            $fclose(rf_file);
            $display("-> Da ghi xong file register_dump.txt");
        end

        dmem_file = $fopen("dmem_dump.txt", "w");
        if (dmem_file) begin
            for (i = 0; i < 256; i = i + 8) begin 
                $fdisplay(dmem_file, "0x%08h    0x%08h 0x%08h 0x%08h 0x%08h 0x%08h 0x%08h 0x%08h 0x%08h",
                    (32'h10010000 + (i * 4)),
                    dut.dmem.ram[i],          
                    dut.dmem.ram[i+1],        
                    dut.dmem.ram[i+2],        
                    dut.dmem.ram[i+3],        
                    dut.dmem.ram[i+4],        
                    dut.dmem.ram[i+5],        
                    dut.dmem.ram[i+6],        
                    dut.dmem.ram[i+7]         
                );
            end
            $fclose(dmem_file);
            $display("-> Da ghi xong file dmem_dump.txt.");
        end

        $display("================ KET QUA KIEM TRA CUOI CUNG ================");
        $display("Register x10 (val): %d", dut.reg_file.rf[10]);
        $display("Register x11 (val): %d", dut.reg_file.rf[11]);
        $display("============================================================\n");
        
        $stop; 
    end

    initial begin
        $timeformat(-9, 1, " ns", 10);
        $monitor("Time: %t | PC: %h | Inst: %h", $time, dut.pc_curr, dut.inst_if);
    end

endmodule