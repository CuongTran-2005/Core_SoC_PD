module RISCV_Pipeline(
    input clk,
    input rst
);

    // --- 1. KHAI BÁO CÁC DÂY NỐI (WIRES) GIỮA CÁC KHỐI ---
    
    // IF Stage
    wire [31:0] pc_next, pc_curr, pc_plus4_if, inst_if;
    wire pc_sel;
    
    // ID Stage
    wire [31:0] pc_id, inst_id, rdata1_id, rdata2_id;
    wire stall_pc, stall_ifid, clr_ifid, clr_idex;
    
    // EX Stage
    wire [31:0] pc_ex, rdata1_ex, rdata2_ex, inst_ex, imm_ex;
    wire [31:0] mux_a_out, mux_b_out, alu_a, alu_b, alu_result_ex;
    wire [1:0] fwAsel, fwBsel;
    wire br_eq, br_lt;
    // Tín hiệu điều khiển từ EXControl
    wire [3:0] alu_sel;
    wire asel, bsel, brun, pc_sel_from_ex;
    wire [2:0] imm_sel;

    // MEM Stage
    wire [31:0] pc_mem, alu_result_mem, rdata2_mem, inst_mem, mem_data_mem;
    wire mem_rw;

    // WB Stage
    wire [31:0] pc_plus4_wb, alu_result_wb, mem_data_wb, inst_wb, wdata_wb;
    wire [1:0] wb_sel;
    wire reg_wen_wb;

    // --- 2. KẾT NỐI CÁC KHỐI THEO SƠ ĐỒ ---

    // ----- STAGE 1: IF (Instruction Fetch) -----
    // Mux chọn PC (nằm trước PC)
    assign pc_next = (pc_sel) ? alu_result_ex : pc_plus4_if;
    assign pc_plus4_if = pc_curr + 4;

    PC pc_reg_inst (
        .clk(clk), .Stall_PC(stall_pc), .PCin(pc_next), .PCout(pc_curr)
    );

    IMEM imem_inst (
        .addr(pc_curr), .inst(inst_if)
    );

    IFID ifid_reg (
        .clk(clk), .stall(stall_ifid), .clr(clr_ifid),
        .PC(pc_curr), .inst(inst_if),
        .PCout(pc_id), .inst_out(inst_id)
    );

    // ----- STAGE 2: ID (Instruction Decode) -----
    RegFile rf_inst (
        .clk(clk),
        .rs1(inst_id[19:15]), .rs2(inst_id[24:20]), .rd(inst_wb[11:7]),
        .wdata(wdata_wb), .RegWEn(reg_wen_wb),
        .rdata1(rdata1_id), .rdata2(rdata2_id)
    );

    Hazard_Detection_Unit hazard_inst (
        .instID(inst_id), .instEX(inst_ex), .PCsel(pc_sel),
        .Stall_PC(stall_pc), .Stall_IFID(stall_ifid), 
        .CLR_IFID(clr_ifid), .CLR_IDEX(clr_idex)
    );

    IDEX idex_reg (
        .clk(clk), .clr(clr_idex),
        .PC(pc_id), .rdata1(rdata1_id), .rdata2(rdata2_id), .inst(inst_id),
        .PCout(pc_ex), .rdata1_out(rdata1_ex), .rdata2_out(rdata2_ex), .inst_out(inst_ex)
    );

    // ----- STAGE 3: EX (Execute) -----
    // Forwarding Muxes (Mux 0,1,2 trong sơ đồ)
    assign mux_a_out = (fwAsel == 2'b00) ? rdata1_ex : 
                       (fwAsel == 2'b01) ? alu_result_mem : wdata_wb;
    assign mux_b_out = (fwBsel == 2'b00) ? rdata2_ex : 
                       (fwBsel == 2'b01) ? alu_result_mem : wdata_wb;

    ImmGen imm_gen_inst (
        .inst(inst_ex), .ImmSel(imm_sel), .imm(imm_ex)
    );

    // ASel, BSel Muxes
    assign alu_a = (asel) ? pc_ex : mux_a_out;
    assign alu_b = (bsel) ? imm_ex : mux_b_out;

    ALU alu_inst (
        .A(alu_a), .B(alu_b), .ALUSel(alu_sel), .ALU_Result(alu_result_ex)
    );

    Branch_Comp br_comp_inst (
        .A(mux_a_out), .B(mux_b_out), .BrUn(brun), .BrEq(br_eq), .BrLT(br_lt)
    );

    EXControl control_inst (
        .instEX(inst_ex), .BrEq(br_eq), .BrLT(br_lt),
        .ImmSel(imm_sel), .BrUn(brun), .Bsel(bsel), .Asel(asel), 
        .ALUSel(alu_sel), .PCsel(pc_sel)
    );

    Forwarding_Unit fwd_inst (
        .instEX(inst_ex), .instM(inst_mem), .instW(inst_wb),
        .fwAsel(fwAsel), .fwBsel(fwBsel)
    );

    EXMEM exmem_reg (
        .clk(clk),
        .PC(pc_ex), .ALU_result(alu_result_ex), .rdata2(mux_b_out), .inst(inst_ex),
        .PCout(pc_mem), .ALU_result_out(alu_result_mem), .rdata2_out(rdata2_mem), .inst_out(inst_mem)
    );

    // ----- STAGE 4: MEM (Memory Access) -----
    DMEM dmem_inst (
        .clk(clk), .addr(alu_result_mem), .wdata(rdata2_mem), 
        .MemRW(mem_rw), .rdata(mem_data_mem)
    );
    
    // Logic cho MemRW (tùy thuộc vào lệnh trong inst_mem)
    assign mem_rw = (inst_mem[6:0] == 7'b0100011); // Ví dụ cho lệnh Store

    MEMWB memwb_reg (
        .clk(clk),
        .PC_plus_4(pc_mem + 4), .ALU_result(alu_result_mem), .mem(mem_data_mem), .inst(inst_mem),
        .PC_plus_4_out(pc_plus4_wb), .ALU_result_out(alu_result_wb), .mem_out(mem_data_wb), .inst_out(inst_wb)
    );

    // ----- STAGE 5: WB (Write Back) -----
    // Mux chọn dữ liệu ghi vào RegFile (WBsel)
    // Giả sử: 0: PC+4, 1: ALU result, 2: Mem data
    assign wdata_wb = (wb_sel == 2'b00) ? pc_plus4_wb :
                      (wb_sel == 2'b01) ? alu_result_wb : mem_data_wb;

    // Các tín hiệu điều khiển cuối cùng (lấy từ opcode của inst_wb)
    assign reg_wen_wb = (inst_wb != 0); // Logic đơn giản hóa
    assign wb_sel = 2'b01; // Logic này nên được lấy từ một bảng Control WB

endmodule