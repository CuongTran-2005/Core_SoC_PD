// IMEM RV32I - word 0..255 (byte 0x000..0x3FC), nap bang $readmemh
050000b7 // 0x000: lui  x1, 0x05000      # x1 = 0x05000000 (SRAM base, bit[26:24]=101)
00f00113 // 0x004: addi x2, x0, 15       # x2 = 15
00700193 // 0x008: addi x3, x0, 7        # x3 = 7
4020a023 // 0x00c: sw   x2, 0x400(x1)    # DMEM[0] = 15
4030a223 // 0x010: sw   x3, 0x404(x1)    # DMEM[1] = 7
4000a203 // 0x014: lw   x4, 0x400(x1)    # x4 = DMEM[0] = 15
4040a283 // 0x018: lw   x5, 0x404(x1)    # x5 = DMEM[1] = 7
00520333 // 0x01c: add  x6, x4, x5       # x6 = 22
405203b3 // 0x020: sub  x7, x4, x5       # x7 = 8
4060a423 // 0x024: sw   x6, 0x408(x1)    # DMEM[2] = 22
0080006f // 0x028: jal  x0, +8           # nhay qua lenh ke tiep -> 0x30
fff00413 // 0x02c: addi x8, x0, -1       # BI BO QUA (x8 phai giu = 0)
4070a623 // 0x030: sw   x7, 0x40C(x1)    # DMEM[3] = 8
0000006f // 0x034: jal  x0, 0            # vong lap vo han (halt)
