// SRAM 1024 x 32 - Nap bang $readmemh
// Test UART Loopback (TX -> RX) voi Core RISC-V:
// 1. Ghi 0x55 vao ULITE_TX (0x02000004) -> cho RXVALID -> doc ULITE_RX -> DMEM[0] (0x05000400)
// 2. Cho TXFULL == 0 -> ghi 0xA5 vao ULITE_TX -> cho RXVALID -> doc ULITE_RX -> DMEM[1] (0x05000404)
// 3. Ghi co hoan tat = 0xCAFEBABE vao DMEM[2] (0x05000408)
@000
020000b7 // 0x000: lui  x1, 0x02000      # x1 = 0x02000000 (UART base)
05000137 // 0x004: lui  x2, 0x05000      # x2 = 0x05000000 (SRAM base)
05500193 // 0x008: addi x3, x0, 0x55     # x3 = 0x55 (byte gui lan 1)
0030a223 // 0x00c: sw   x3, 4(x1)        # ULITE_TX (0x02000004) = 0x55
0080a203 // 0x010: lw   x4, 8(x1)        # x4 = ULITE_STATUS (0x02000008)
00127213 // 0x014: andi x4, x4, 1        # loc bit 0 (RXVALID)
fe020ce3 // 0x018: beq  x4, x0, -8       # neu RXVALID == 0 -> quay lai 0x010
0000a283 // 0x01c: lw   x5, 0(x1)        # x5 = ULITE_RX (0x02000000)
40512023 // 0x020: sw   x5, 0x400(x2)    # DMEM[0] (0x05000400) = x5 (0x55)
0080a203 // 0x024: lw   x4, 8(x1)        # x4 = ULITE_STATUS (0x02000008)
00827213 // 0x028: andi x4, x4, 8        # loc bit 3 (TXFULL)
fe021ce3 // 0x02c: bne  x4, x0, -8       # neu TXFULL != 0 -> quay lai 0x024
0a500193 // 0x030: addi x3, x0, 0xA5     # x3 = 0xA5 (byte gui lan 2)
0030a223 // 0x034: sw   x3, 4(x1)        # ULITE_TX (0x02000004) = 0xA5
0080a203 // 0x038: lw   x4, 8(x1)        # x4 = ULITE_STATUS (0x02000008)
00127213 // 0x03c: andi x4, x4, 1        # loc bit 0 (RXVALID)
fe020ce3 // 0x040: beq  x4, x0, -8       # neu RXVALID == 0 -> quay lai 0x038
0000a303 // 0x044: lw   x6, 0(x1)        # x6 = ULITE_RX (0x02000000)
40612223 // 0x048: sw   x6, 0x404(x2)    # DMEM[1] (0x05000404) = x6 (0xA5)
cafec3b7 // 0x04c: lui  x7, 0xCAFEC      # x7 = 0xCAFEC000
abe38393 // 0x050: addi x7, x7, -1346    # x7 = 0xCAFEBABE (0xCAFEC000 - 0x542)
40712423 // 0x054: sw   x7, 0x408(x2)    # DMEM[2] (0x05000408) = 0xCAFEBABE
0000006f // 0x058: jal  x0, 0            # Loop forever